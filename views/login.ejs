<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineData API — Developer Sign In</title>
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  <link rel="stylesheet" href="/style.css">
  <!-- FontAwesome Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body style="background: var(--color-paper-100); display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 1rem;">

  <!-- Dedicated Auth Screen (Login / Register) -->
  <div class="auth-wrapper" style="display: flex;">
    <div class="auth-card">
      <div class="brand-logo" style="justify-content: center; margin-bottom: 1.5rem;">
        <img src="/logo.svg" alt="CineData Logo" style="width: 34px; height: 34px; border-radius: 8px;">
        <span class="brand-title" style="font-size: 1.35rem;">CineData Platform</span>
      </div>
      <h2 id="auth-title" class="auth-title" style="display: none;"></h2>
      <p id="auth-subtitle" class="auth-subtitle">Akses kredensial API key, sandbox, dan analitik telemetri Anda</p>

      <form id="auth-form">
        <div class="form-group" id="name-group" style="display: none;">
          <label class="form-label"><i class="fa-solid fa-user" style="margin-right: 0.35rem; color: var(--color-text-dim);"></i>Nama Lengkap</label>
          <input type="text" id="auth-name" class="form-input" placeholder="Nama Developer">
        </div>
        <div class="form-group">
          <label class="form-label"><i class="fa-solid fa-envelope" style="margin-right: 0.35rem; color: var(--color-text-dim);"></i>Alamat Email</label>
          <input type="email" id="auth-email" class="form-input" placeholder="admin@cinedata.io" required>
        </div>
        <div class="form-group">
          <label class="form-label"><i class="fa-solid fa-lock" style="margin-right: 0.35rem; color: var(--color-text-dim);"></i>Kata Sandi</label>
          <input type="password" id="auth-password" class="form-input" placeholder="Masukkan password" required>
        </div>
        <button type="submit" id="auth-submit-btn" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 0.65rem; margin-top: 1rem;">
          <i class="fa-solid fa-right-to-bracket" style="margin-right: 0.4rem;"></i>Login
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--color-text-muted);">
        <span id="auth-toggle-msg">Belum memiliki akun?</span>
        <a href="#" id="auth-toggle-btn" style="font-weight: 600; margin-left: 0.25rem;"><i class="fa-solid fa-user-plus" style="margin-right: 0.25rem;"></i>Buat Akun Baru</a>
      </div>
    </div>
  </div>

  <script src="/login.js"></script>
</body>
</html>
